{
  "info": {
    "name": "Task Management API",
    "description": "RESTful API for a simple Task Management System (Laravel 12 + Sanctum).\n\nGetting started:\n1. Run the API locally: `php artisan migrate --seed && php artisan serve`.\n2. Send `Auth / Login` with the seeded demo account (demo@example.com / password). The token is captured automatically into the `token` collection variable, so every other request is authenticated from then on.\n3. `Projects / Create project` and `Tasks / Create task` store their new ids into `project_id` and `task_id`, so the requests that follow work without editing anything by hand.\n\nAdjust `base_url` if you serve on a different host or port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "project_id", "value": "", "type": "string" },
    { "key": "task_id", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane+{{$randomInt}}@example.com\",\n  \"password\": \"secret-password\",\n  \"password_confirmation\": \"secret-password\"\n}"
            },
            "url": { "raw": "{{base_url}}/register", "host": ["{{base_url}}"], "path": ["register"] },
            "description": "Creates a user and issues an API token.\n\nValidation: `name` required (max 255), `email` required and unique, `password` required, at least 8 characters, and must match `password_confirmation`.\n\nReturns 201, or 422 when the payload is invalid or the email is taken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] },
            "description": "Authenticates and issues a token, saved into the `token` collection variable.\n\nBad credentials return 401 with one generic message for both an unknown email and a wrong password. Rate limited to 6 attempts per minute (429 after that)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] },
            "description": "Returns the authenticated user. 401 without a valid token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Current user without a token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] },
            "description": "The same endpoint without an Authorization header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects?per_page=15&page=1",
              "host": ["{{base_url}}"],
              "path": ["projects"],
              "query": [
                { "key": "per_page", "value": "15", "description": "1-100, default 15" },
                { "key": "page", "value": "1" }
              ]
            },
            "description": "The authenticated user's own projects, newest first, each with a `tasks_count`. Another user's projects never appear."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is paginated', () => pm.expect(pm.response.json().meta).to.have.property('total'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Redesign\",\n  \"description\": \"Rebuild the marketing site.\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "description": "Creates a project owned by the authenticated user.\n\n`name` required (max 255), `description` optional (max 5000, nullable), `status` optional and one of `active` / `completed` / `archived` — defaults to `active`.\n\nA `user_id` in the payload is ignored; ownership always comes from the token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('project_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}"]
            },
            "description": "200 for your own project, 403 for someone else's, 404 if it does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Update project",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" },
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}"]
            },
            "description": "Partial update — send only the fields you want to change. A field that is sent must still be valid: `name` and `status` cannot be blanked. PATCH works identically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status changed', () => pm.expect(pm.response.json().data.status).to.eql('completed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get another user's project (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/4",
              "host": ["{{base_url}}"],
              "path": ["projects", "4"]
            },
            "description": "Ownership check against seeded data: the demo account owns projects 1-3, so project 4 belongs to someone else. The API answers 403 — not 404, and not the record."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('reveals nothing about the record', () => pm.expect(pm.response.text()).to.not.include('name'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List tasks of a project",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/tasks?status=&priority=&search=&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "tasks"],
              "query": [
                { "key": "status", "value": "", "description": "todo | in_progress | done" },
                { "key": "priority", "value": "", "description": "low | medium | high" },
                { "key": "search", "value": "", "description": "matches part of the title, case-insensitive" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "Tasks of one project. All three filters combine. An empty value means 'no filter'; an unknown value returns 422 rather than an empty list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write the API docs\",\n  \"description\": \"Cover every endpoint.\",\n  \"priority\": \"high\",\n  \"status\": \"todo\",\n  \"due_date\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}/tasks",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}", "tasks"]
            },
            "description": "Adds a task to a project you own.\n\n`title` required (max 255). `description` optional. `priority` defaults to `medium`, `status` to `todo`. `due_date` is optional and nullable — past dates are accepted so existing overdue work can be recorded.\n\n403 if the project belongs to someone else, 404 if it does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('task_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List all tasks (across projects)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tasks?status=todo&priority=high&search=&per_page=15",
              "host": ["{{base_url}}"],
              "path": ["tasks"],
              "query": [
                { "key": "status", "value": "todo", "description": "todo | in_progress | done" },
                { "key": "priority", "value": "high", "description": "low | medium | high" },
                { "key": "search", "value": "", "description": "matches part of the title" },
                { "key": "per_page", "value": "15" }
              ]
            },
            "description": "Every task the user owns across all their projects, with the owning project embedded in each row. Same filters as the per-project listing. Tasks whose project was deleted do not appear."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get task",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{task_id}}"]
            },
            "description": "`is_overdue` is true when the due date has passed and the task is not `done`. A task due today is not yet overdue."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"done\"\n}" },
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{task_id}}"]
            },
            "description": "Partial update. Send `\"due_date\": null` to clear the deadline; the other fields cannot be blanked. A `project_id` in the payload is ignored — tasks cannot be moved between projects."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status changed', () => pm.expect(pm.response.json().data.status).to.eql('done'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["tasks", "{{task_id}}"]
            },
            "description": "Soft deletes the task. Returns 204 with no body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Invalid filter value (422)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tasks?status=blah",
              "host": ["{{base_url}}"],
              "path": ["tasks"],
              "query": [{ "key": "status", "value": "blah" }]
            },
            "description": "Filter values are validated. An unknown status returns 422 with an `errors` object, instead of an empty list that would look like a legitimate no-match."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('names the offending field', () => pm.expect(pm.response.json().errors).to.have.property('status'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/dashboard", "host": ["{{base_url}}"], "path": ["dashboard"] },
            "description": "Aggregated figures for the authenticated user only.\n\n`pending_tasks` is everything not `done`. `overdue_tasks` counts tasks whose due date is before today and whose status is not `done` — the same rule as the `is_overdue` flag in the task listings."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('has all six figures', () => pm.expect(Object.keys(d)).to.have.lengthOf(6));",
                  "pm.test('pending + completed = total', () => pm.expect(d.pending_tasks + d.completed_tasks).to.eql(d.total_tasks));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Unauthenticated (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "description": "Every endpoint except register and login requires a token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Not found (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/999999",
              "host": ["{{base_url}}"],
              "path": ["projects", "999999"]
            },
            "description": "The message is deliberately generic and never names the model class behind the route."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('leaks no internals', () => pm.expect(pm.response.text()).to.not.include('App\\\\Models'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation failed (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"nope\"\n}" },
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "description": "Missing `name` and an invalid `status`. Errors are returned together, keyed by field."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "const e = pm.response.json().errors;",
                  "pm.test('reports both fields', () => { pm.expect(e).to.have.property('name'); pm.expect(e).to.have.property('status'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Method not allowed (405)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] },
            "description": "The collection route has no DELETE handler."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('405 Method Not Allowed', () => pm.response.to.have.status(405));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup (run last)",
      "description": "Destructive requests, kept at the end so the collection can be run top to bottom in one go. Deleting the project earlier would take its tasks out of the API with it, and logging out earlier would invalidate the token for everything below.",
      "item": [
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["projects", "{{project_id}}"]
            },
            "description": "Soft deletes the project and returns 204 with no body. Its tasks stay in the database so the project remains restorable, but both disappear from the API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/logout", "host": ["{{base_url}}"], "path": ["logout"] },
            "description": "Revokes only the token used for this request, leaving the user's other devices signed in. Send Login again to continue working."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', '');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
